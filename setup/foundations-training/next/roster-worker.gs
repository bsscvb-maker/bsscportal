/* Native roster workflow; activation captures existing members and never backfills them. */
const MEMBER_OUTBOX_HEADERS=['Event Key','Enrollment ID','Member Key','Full Name','Email','Kind','Milestone','Days Remaining','Due At','Status','Reserved At','Sent At','Message ID','Error Code'];
const MEMBER_ACCOUNT_HEADERS=['Account UID','Enrollment ID','Email','Full Name','Created At','First Login At','Password Changed At','Temporary Expires At','Status'];
function memberTable_(name,headers,create){const book=SpreadsheetApp.openById(LMS_BOOK);let sheet=book.getSheetByName(name);if(!sheet&&create)sheet=book.insertSheet(name);if(sheet&&create&&sheet.getLastRow()===0){sheet.getRange(1,1,1,headers.length).setValues([headers]);sheet.setFrozenRows(1);sheet.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#202329').setFontColor('#ffffff');sheet.setColumnWidths(1,headers.length,170);SpreadsheetApp.flush();}if(!sheet)return null;const rows=sheet.getRange(1,1,Math.max(1,sheet.getLastRow()),headers.length).getValues();if(headers.some((h,i)=>rows[0][i]!==h))throw Error(name+' headings need review.');return {sheet,rows};}
function memberSaveAccount_(account,name){const table=memberTable_('LMS Accounts',MEMBER_ACCOUNT_HEADERS,false);if(!table)return;const row=table.rows.findIndex((r,i)=>i>0&&r[0]===account.uid),values=[account.uid,account.enrollmentId,account.email,name||account.name||'',account.createdAt||'',account.firstLoginAt||'',account.passwordChangedAt||'',account.temporaryExpiresAt||'',account.archived?'Archived':account.mustSetupPassword?'Setup required':account.mustChangePassword?'Password change required':'Active'];if(row>0)table.sheet.getRange(row+1,1,1,values.length).setValues([values]);else table.sheet.appendRow(values);}
function memberRoster_(){const book=SpreadsheetApp.openById(LMS_BOOK),year=Number(Utilities.formatDate(new Date(),TIME_ZONE,'yyyy')),members=[];for(const title of [String(year),String(year+1)]){const sheet=book.getSheetByName(title);if(!sheet)continue;const values=sheet.getDataRange().getValues(),heads=values[0],index=label=>heads.indexOf(label);for(const field of ['Status','Last Name','First Name','Email','Start Date'])if(index(field)<0)throw Error('Roster '+title+' needs '+field+'.');for(const row of values.slice(1)){const first=String(row[index('First Name')]||'').trim(),last=String(row[index('Last Name')]||'').trim();if(!first&&!last)continue;const name=(first+' '+last).trim(),email=String(row[index('Email')]||'').trim().toLowerCase(),status=String(row[index('Status')]||'').trim();const nameKey=memberDigest_(name.toLowerCase().replace(/\s+/g,' ')),emailKey=memberDigest_(email);members.push({name,email,status,startDate:row[index('Start Date')],nameKey,emailKey,sourceYear:title});}}
 const setting=lmsTable_(book,'LMS Settings').rows.find(row=>row[0]==='Training exemptions');
 const exemptNames=new Set(setting&&setting[1]?JSON.parse(setting[1]).map(name=>name.trim().toLowerCase()):[]);
 const unique=new Map();for(const member of members){member.trainingExempt=exemptNames.has(member.name.toLowerCase());const old=unique.get(member.nameKey);if(old&&old.email!==member.email){old.conflict=true;continue}if(!old||member.sourceYear===String(year))unique.set(member.nameKey,member);}return [...unique.values()];}
function memberTrainingExempt_(member, now=Date.now()){
 if(member?.trainingExempt)return true;
 if(!member||member.conflict||!(member.startDate instanceof Date)||isNaN(member.startDate.getTime()))return false;
 const today=localDay(now);
 const cutoff=String(Number(today.slice(0,4))-5).padStart(4,'0')+today.slice(4);
 return localDay(member.startDate)<cutoff;
}
function memberDueTimestamp_(day){const offset=Utilities.formatDate(new Date(day+'T23:59:59Z'),TIME_ZONE,'Z');return new Date(day+'T23:59:59'+offset.slice(0,3)+':'+offset.slice(3)).toISOString();}
function memberOutbox_(event){const table=memberTable_('LMS Outbox',MEMBER_OUTBOX_HEADERS,true),row=table.rows.findIndex((r,i)=>i>0&&r[0]===event.key);if(row>0)return null;const values=[event.key,event.enrollmentId||'',event.memberKey||'',event.name||'',event.email||'',event.kind||'',event.milestone||'',event.daysRemaining||'',event.dueAt||'','Reserved',new Date().toISOString(),'','',''];table.sheet.appendRow(values);return {sheet:table.sheet,row:table.sheet.getLastRow(),values};}
function memberOutboxFinish_(entry,status,errorCode){if(!entry)return;entry.values[9]=status;if(status==='Sent')entry.values[11]=new Date().toISOString();entry.values[13]=errorCode||'';entry.sheet.getRange(entry.row,1,1,entry.values.length).setValues([entry.values]);}
function activateRosterTraining(){if(lmsIdentity_()!==LMS_OWNER)throw Error('Only the BSSC service owner can activate roster enrollment.');memberConfig_();const p=PropertiesService.getScriptProperties();if(p.getProperty('LMS_ROSTER_ACTIVATED_AT'))throw Error('Roster activation already has a baseline. Do not reset existing due dates.');const members=memberRoster_(),now=new Date().toISOString();memberTable_('LMS Outbox',MEMBER_OUTBOX_HEADERS,true);memberTable_('LMS Accounts',MEMBER_ACCOUNT_HEADERS,true);p.setProperties({LMS_ROSTER_BASELINE:JSON.stringify({names:members.map(m=>m.nameKey),emails:members.map(m=>m.emailKey)}),LMS_ROSTER_ACTIVATED_AT:now,LMS_ROSTER_AUTOMATIONS_ENABLED:'true'});console.log('Roster automation baseline captured for '+members.length+' existing people. No historical invitations or reminders sent. Install the hourly lmsRosterClock trigger to start monitoring.');}
function pauseRosterTraining(){if(lmsIdentity_()!==LMS_OWNER)throw Error('Only the BSSC service owner can pause this workflow.');PropertiesService.getScriptProperties().setProperty('LMS_ROSTER_AUTOMATIONS_ENABLED','false');console.log('New invitations and countdown messages are paused.');}
function lmsRosterClock(){if(lmsIdentity_()!==LMS_OWNER)throw Error('The roster clock requires the authorized club administrator.');return lmsRosterClock_();}
function lmsRosterClock_(){const p=PropertiesService.getScriptProperties();if(p.getProperty('LMS_ROSTER_AUTOMATIONS_ENABLED')!=='true')return;memberConfig_();let lock=LockService.getScriptLock();if(!lock.tryLock(20000))return;let sent=0,reviewed=0;try{const activated=p.getProperty('LMS_ROSTER_ACTIVATED_AT'),baseline=JSON.parse(p.getProperty('LMS_ROSTER_BASELINE')||'null');if(!activated||!baseline)throw Error('A verified roster baseline is required.');const members=memberRoster_(),book=SpreadsheetApp.openById(LMS_BOOK),table=lmsTable_(book,'LMS Enrollments'),emails=new Map();const inPerson=inPersonInvitations_(book);sent+=inPerson.sent;reviewed+=inPerson.reviewed;table.rows=lmsTable_(book,'LMS Enrollments').rows;for(const m of members)emails.set(m.email,(emails.get(m.email)||0)+1);
 for(const m of members){if(memberTrainingExempt_(m))continue;if(baseline.names.includes(m.nameKey)||baseline.emails.includes(m.emailKey))continue;if(!['active','prospect','pending'].includes(m.status.toLowerCase()))continue;const key='roster:'+m.nameKey;if(table.rows.slice(1).some(r=>String(r[3]).toLowerCase()===m.email))continue;const started=m.startDate instanceof Date?localDay(m.startDate):'';const invalid=m.conflict||!m.name||!/^\S+@\S+\.\S+$/.test(m.email)||emails.get(m.email)!==1||!started||started<localDay(activated);if(invalid){const entry=memberOutbox_({key,name:m.name,email:m.email,kind:'Roster review'});memberOutboxFinish_(entry,'Needs review','IDENTITY_OR_START_DATE');if(entry)reviewed++;continue;}if(MailApp.getRemainingDailyQuota()<1)break;const enrollmentId='LMS-'+Utilities.getUuid(),memberKey='MEMBER-'+Utilities.getUuid(),due=dueDay(Date.now()),dueAt=memberDueTimestamp_(due),entry=memberOutbox_({key,enrollmentId,memberKey,name:m.name,email:m.email,kind:'Invitation',daysRemaining:60,dueAt});if(!entry)continue;
  const row=[enrollmentId,memberKey,m.name,m.email,m.status,LMS_VERSION,'Official','','',LMS_OWNER,'','','','','','',`Automatic roster enrollment (${m.sourceYear})`,false,0];table.sheet.appendRow(row);
  try{const provisioned=memberProvision_(enrollmentId),mail=trainingEmail({kind:'invitation',name:m.name,email:m.email,dueDay:due,welcomeUrl:provisioned.welcomeUrl});MailApp.sendEmail({to:m.email,subject:mail.subject,body:mail.text,htmlBody:mail.html,name:'BoneShakers Social Club',replyTo:'president@boneshakerssocialclub.com'});const at=new Date().toISOString(),enrollmentRow=table.sheet.getLastRow();table.sheet.getRange(enrollmentRow,8,1,2).setValues([[at,dueAt]]);memberSaveAccount_({...provisioned.account,name:m.name},m.name);memberOutboxFinish_(entry,'Sent');sent++;baseline.names.push(m.nameKey);baseline.emails.push(m.emailKey);p.setProperty('LMS_ROSTER_BASELINE',JSON.stringify(baseline));}catch(error){memberOutboxFinish_(entry,'Needs review','INVITATION_OUTCOME_REQUIRES_REVIEW');}
 }
 if(Number(Utilities.formatDate(new Date(),TIME_ZONE,'H'))>=9){const enrollments=lmsTable_(book,'LMS Enrollments'),outbox=memberTable_('LMS Outbox',MEMBER_OUTBOX_HEADERS,true),ledger=outbox.rows.slice(1).map(r=>({key:r[0],status:r[9]==='Reserved'?'Sending':r[9]==='Needs review'?'Unknown':r[9]}));for(const row of enrollments.rows.slice(1)){if(!outbox.rows.some(r=>r[1]===row[0]&&r[5]==='Invitation'&&r[9]==='Sent'))continue;if(row[6]!=='Official'||row[17]===true||!row[7]||!row[8])continue;if(lmsAttendance_(book,{row}))continue;const roster=members.find(m=>m.email===String(row[3]).toLowerCase());if(!roster||memberTrainingExempt_(roster)||!['active','prospect','pending'].includes(roster.status.toLowerCase()))continue;const state=row[14]?JSON.parse(row[14]):initialState(),sections=state.sections.map((s,i)=>({section:i+1,passed:s.passed,bestScore:s.bestScore})),completion=state.completion?{...state.completion,enrollmentId:row[0],courseVersion:state.completion.courseVersion}:null,e={id:row[0],email:row[3],name:row[2],recordType:row[6],courseVersion:row[5],archived:row[17],deliveryStatus:'Sent',invitedAt:row[7],dueDay:localDay(row[8]),sections,completion};const event=nextReminder(e,Date.now(),ledger);if(!event||MailApp.getRemainingDailyQuota()<1)continue;const entry=memberOutbox_({...event,email:e.email,name:e.name,memberKey:row[1],dueAt:row[8]});if(!entry)continue;try{const mail=trainingEmail({kind:'reminder',name:e.name,email:e.email,dueDay:e.dueDay,daysRemaining:event.daysRemaining,passed:sections.filter(s=>s.passed).length});MailApp.sendEmail({to:e.email,subject:mail.subject,body:mail.text,htmlBody:mail.html,name:'BoneShakers Social Club',replyTo:'president@boneshakerssocialclub.com'});memberOutboxFinish_(entry,'Sent');sent++;}catch(error){memberOutboxFinish_(entry,'Needs review','SEND_OUTCOME_REQUIRES_REVIEW');}}}
 p.setProperty('LMS_ROSTER_LAST_CHECK',new Date().toISOString());console.log('Roster check completed. Messages sent: '+sent+'. Identities needing review: '+reviewed+'.');
 }finally{lock.releaseLock();}}
