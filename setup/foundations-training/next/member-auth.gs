/* Managed email/password gateway. Disabled until owner configures LMS_MEMBER_AUTH_ENABLED. */
function memberConfig_(){const p=PropertiesService.getScriptProperties(),apiKey=p.getProperty('LMS_FIREBASE_API_KEY'),projectId=p.getProperty('LMS_FIREBASE_PROJECT');if(p.getProperty('LMS_MEMBER_AUTH_ENABLED')!=='true'||!apiKey||!projectId)throw new TrainingError('Member email login is not active yet.',503);return {p,apiKey,projectId};}
function memberFetch_(path,payload,admin){const c=memberConfig_(),url='https://identitytoolkit.googleapis.com/v1/'+(admin?'projects/'+encodeURIComponent(c.projectId)+'/':'')+path+(admin?'':'?key='+encodeURIComponent(c.apiKey)),options={method:'post',contentType:'application/json',payload:JSON.stringify(payload),muteHttpExceptions:true};if(admin)options.headers={Authorization:'Bearer '+ScriptApp.getOAuthToken(),'X-Goog-User-Project':c.projectId};const response=UrlFetchApp.fetch(url,options),status=response.getResponseCode();let data;try{data=JSON.parse(response.getContentText())}catch(e){throw new TrainingError('The account service could not be reached.',503)}if(status<200||status>=300){const error=new TrainingError('The account service could not complete this request. Check your sign-in or contact the President.',status===400||status===401?401:503);error.providerStatus=status;error.providerConsumer=String(data.error?.details?.find(d=>d.metadata?.consumer)?.metadata?.consumer||'').replace(/[^a-zA-Z0-9_/-]/g,'').slice(0,80);error.providerCode=String(data.error?.message||data.error?.status||'REQUEST_FAILED').split(':')[0].replace(/[^A-Z_]/g,'').slice(0,80);throw error;}return data;}
function memberDigest_(value){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value,Utilities.Charset.UTF_8).map(b=>(b&255).toString(16).padStart(2,'0')).join('');}
function memberError_(error){return {error:error instanceof TrainingError?error.message:'The account service is temporarily unavailable. Please try again.',status:error.status||500};}
function memberIdentity_(input,allowTemporary){if(!input||typeof input.idToken!=='string'||input.idToken.length<100||input.idToken.length>6000)throw new TrainingError('Sign in with your training email and password.',401);const c=memberConfig_(),response=memberFetch_('accounts:lookup',{idToken:input.idToken},false);if(response.users?.length!==1)throw new TrainingError('Sign in again to continue.',401);const u=response.users[0],raw=c.p.getProperty('LMS_MEMBER_'+u.localId);if(!raw||u.disabled)throw new TrainingError('This account is not enrolled in Foundations. Contact the President.',403);const account=JSON.parse(raw),email=String(u.email||'').trim().toLowerCase();if(account.email!==email||account.archived||!account.enrollmentId)throw new TrainingError('Your account enrollment needs review. Contact the President.',403);if(account.minimumAuthTime){let claims;try{claims=JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(input.idToken.split('.')[1])).getDataAsString());}catch(error){throw new TrainingError('Sign in again after changing your password.',401);}if(Number(claims.auth_time||0)<account.minimumAuthTime)throw new TrainingError('Sign in again with your new password.',401);}
if(account.mustSetupPassword){if(!allowTemporary)throw new TrainingError('Use the setup email to choose your own password before opening training.',428);}
else if(account.mustChangePassword){const wasReset=Number(u.passwordUpdatedAt)>Number(account.initialPasswordUpdatedAt);if(wasReset){let claims;try{claims=JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(input.idToken.split('.')[1])).getDataAsString());}catch(error){throw new TrainingError('Sign in again with the password you chose.',401);}if(Number(claims.auth_time||0)<Math.floor(Number(u.passwordUpdatedAt)/1000))throw new TrainingError('Sign in again with the password you chose.',401);account.mustChangePassword=false;account.passwordChangedAt=new Date(Number(u.passwordUpdatedAt)).toISOString();delete account.initialDigest;delete account.salt;delete account.initialPasswordUpdatedAt;c.p.setProperty('LMS_MEMBER_'+u.localId,JSON.stringify(account));}else{if(Date.now()>Date.parse(account.temporaryExpiresAt))throw new TrainingError('Your temporary password has expired. Use Set up / reset password to choose your own password.',401);if(!allowTemporary)throw new TrainingError('Change your temporary password before opening your training.',428);}}
return {email,uid:u.localId,enrollmentId:account.enrollmentId,account};}
function memberSession(input){try{const identity=memberIdentity_(input,true),book=SpreadsheetApp.openById(LMS_BOOK),user=lmsUser_(book,identity.email);if(user.row[0]!==identity.enrollmentId)throw new TrainingError('The account and enrollment do not match. Contact the President.',403);if(!identity.account.firstLoginAt){identity.account.firstLoginAt=new Date().toISOString();memberConfig_().p.setProperty('LMS_MEMBER_'+identity.uid,JSON.stringify(identity.account));}if(typeof memberSaveAccount_==='function')memberSaveAccount_(identity.account,user.row[2]);return {email:identity.email,name:user.row[2],requiresPasswordChange:Boolean(identity.account.mustChangePassword),requiresPasswordSetup:Boolean(identity.account.mustSetupPassword)};}catch(error){return memberError_(error)}}
function memberLmsRequest(input){try{const identity=memberIdentity_(input,false);return lmsHandle_(input,identity);}catch(error){return memberError_(error)}}
function memberChangePassword(input){let lock;try{const identity=memberIdentity_(input,true),password=input.newPassword;if(typeof password!=='string'||password.length<12||password.length>128)throw new TrainingError('Choose a password from 12 to 128 characters.');const account=identity.account;if(account.mustSetupPassword)throw new TrainingError('Use the secure setup link sent to your email.',428);if(account.initialDigest&&memberDigest_(account.salt+password)===account.initialDigest)throw new TrainingError('Choose a password different from your temporary password.');lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw new TrainingError('Your account is busy. Please try again.',503);const response=memberFetch_('accounts:update',{idToken:input.idToken,password,returnSecureToken:true},false);account.mustChangePassword=false;account.passwordChangedAt=new Date().toISOString();delete account.initialDigest;delete account.salt;delete account.initialPasswordUpdatedAt;memberConfig_().p.setProperty('LMS_MEMBER_'+identity.uid,JSON.stringify(account));if(typeof memberSaveAccount_==='function')memberSaveAccount_(account,account.name);return {email:identity.email,idToken:response.idToken,refreshToken:response.refreshToken,expiresIn:response.expiresIn};}catch(error){return memberError_(error)}finally{if(lock)lock.releaseLock()}}
// Owner-only provisioner; callers cannot bind themselves to another enrollment.
function memberProvision_(enrollmentId){if(lmsIdentity_()!==LMS_OWNER)throw new TrainingError('Only the BSSC account owner can provision training accounts.',403);const c=memberConfig_(),book=SpreadsheetApp.openById(LMS_BOOK),table=lmsTable_(book,'LMS Enrollments'),matches=table.rows.slice(1).filter(r=>r[0]===enrollmentId);if(matches.length!==1||matches[0][17]===true)throw new TrainingError('Select one active enrollment.');const row=matches[0],email=String(row[3]||'').trim().toLowerCase();if(!/^\S+@\S+\.\S+$/.test(email))throw new TrainingError('The enrollment needs a deliverable email.');const emailKey='LMS_MEMBER_EMAIL_'+memberDigest_(email),existing=c.p.getProperty(emailKey);if(existing)throw new TrainingError('This email already has a managed account. Review it instead of creating another.');const created=memberFetch_('accounts',{email,displayName:String(row[2])},true);if(!created.localId)throw new TrainingError('The account was not created.',503);const now=Date.now(),account={email,name:String(row[2]),enrollmentId,uid:created.localId,mustSetupPassword:true,mustChangePassword:false,createdAt:new Date(now).toISOString(),initialPasswordUpdatedAt:Number(created.passwordUpdatedAt||now)};c.p.setProperty('LMS_MEMBER_'+created.localId,JSON.stringify(account));c.p.setProperty(emailKey,created.localId);const welcomeUrl=memberWelcome_(account);return {account,welcomeUrl,name:row[2]};}
function configureManagedAccounts(){if(lmsIdentity_()!==LMS_OWNER)throw Error('Only the BSSC service owner can configure managed accounts.');const p=PropertiesService.getScriptProperties();p.setProperties({LMS_FIREBASE_PROJECT:'bssc-foundations-training',LMS_FIREBASE_API_KEY:'AIzaSyB4KpAvJFa8SIXg08ecRPMP0JF-DEIZX8g',LMS_MEMBER_AUTH_ENABLED:'true'});try{memberFetch_('accounts:lookup',{localId:['__BSSC_AUTH_PROBE__']},true);const quota=MailApp.getRemainingDailyQuota();if(typeof memberTable_==='function'){memberTable_('LMS Accounts',MEMBER_ACCOUNT_HEADERS,true);memberTable_('LMS Outbox',MEMBER_OUTBOX_HEADERS,true);}console.log('Managed account access authorized. Mail capacity: '+quota+'. No learner accounts or emails were created. Roster automation remains paused.');}catch(error){p.setProperty('LMS_MEMBER_AUTH_ENABLED','false');console.log('Account configuration detail: '+String(error.message).slice(0,400));console.log('Account authorization status: '+(error.providerStatus||error.status||'unavailable')+' '+(error.providerCode||'')+' '+(error.providerConsumer||''));throw Error('Managed account authorization could not be verified. No learner accounts or messages were created.');}}
function sendOwnerManagedLoginTest(){if(lmsIdentity_()!==LMS_OWNER)throw Error('Only the BSSC service owner may send this test.');const p=PropertiesService.getScriptProperties();if(p.getProperty('LMS_OWNER_LOGIN_TEST'))throw Error('The owner welcome test was already reserved or sent. Review its delivery before retrying.');p.setProperty('LMS_OWNER_LOGIN_TEST','Reserved');try{const provisioned=memberProvision_('LMS-PRACTICE-TODD-20261120'),email=trainingEmail({kind:'invitation',name:provisioned.name,email:LMS_OWNER,dueDay:dueDay(Date.now()),welcomeUrl:provisioned.welcomeUrl}),banner='<p style="padding:14px;background:#fff0cd;font:14px Arial">BSSC LMS PRACTICE TEST — This invitation is for Todd’s existing Practice record. It is not an official membership deadline.</p>';MailApp.sendEmail({to:LMS_OWNER,subject:'[BSSC LMS TEST] '+email.subject,body:'PRACTICE TEST — no official membership deadline.\n\n'+email.text,htmlBody:email.html.replace('<body ', '<body ').replace('<div style="display:none;',banner+'<div style="display:none;'),name:'BoneShakers Social Club',replyTo:'president@boneshakerssocialclub.com'});p.setProperty('LMS_OWNER_LOGIN_TEST','Sent '+new Date().toISOString());console.log('One Practice welcome test sent to the BSSC service owner. No other invitations or reminders were sent.');}catch(error){p.setProperty('LMS_OWNER_LOGIN_TEST','Needs review');throw Error('The welcome test needs delivery review before another attempt. No passwords have been logged.');}}
