const BOOK=PropertiesService.getScriptProperties().getProperty('BOOK');
const PARENT=PropertiesService.getScriptProperties().getProperty('PARENT');
const VERSION='BSSC Board Service Requirements 2027 v2 2026-10-27';
const SECTIONS=[["Eligibility and term", "Your eligibility, election, appointment and term are governed by the adopted bylaws. Full voting membership in good standing, applicable renewal requirements and candidate qualifications must be verified from club records. Signing this acknowledgment does not grant a Board seat or an officer title. Confirm your actual term before signing."], ["Commitment and attendance", "Serve your authorized term, prepare for and attend Board meetings, participate in general meetings, events and fundraisers, and complete assigned work between meetings. Notify the President AND Vice President at least 24 hours before an absence when practicable, or as soon as possible in a true emergency. Attendance exceptions, review and removal follow the adopted bylaws."], ["Representation and respectful conduct", "Uphold the club\u2019s mission and reputation. Act respectfully toward members, officers, partners and the public. Follow meeting procedures and the chair\u2019s authorized directions. Ask questions and disagree constructively without threats, intimidation, personal attacks or disruption. Any corrective action follows the bylaws and fair process."], ["Responsibilities and practical skills", "Review budgets, donations, policies and bylaws before voting. Use the club\u2019s email, phone and approved digital tools. Lead or support assigned committees, projects and events. Report progress, protect records and ask for help before deadlines are missed."], ["Confidentiality and conflicts", "Protect private Board business, member information, finances and other nonpublic information during and after service. Confidentiality does not prevent required disclosures, good-faith reports to appropriate authorities or confidential professional advice. Disclose conflicts of interest and follow the applicable recusal rules."], ["Financial and nonprofit stewardship", "Act in the club\u2019s best interests, follow spending and contract approval limits, keep receipts and protect designated funds. Support nonprofit and tax-exempt compliance. Do not make unauthorized commitments in the club\u2019s name. Complete any conflict-of-interest disclosure required by the Board."], ["Fundraising and member support", "Support fundraising through volunteer time, promotion and practical work. Personal contributions are encouraged when able; no donation minimum is created here. Welcome and mentor members and support membership growth and retention."], ["Officer selection and handover", "Election to the Board does not guarantee a particular office. Officer selection follows the bylaws. Be willing to support the assigned structure and learn your responsibilities. Transfer records, property, access and outstanding work through a documented handover when your role ends."], ["Governing authority", "The adopted bylaws and operating policies control over this acknowledgment. This form does not amend qualifications, terms, authority, voting thresholds or removal procedures. Duties and conduct concerns are reviewed under the bylaws with required notice and a chance to respond. Based on the 2026 Requirements to Serve acknowledgment, updated for current governance wording."]];
const STATEMENT="I accept my election or appointment to the BSSC Board for the service year shown. I have read, understand and agree to uphold the Board Service Requirements and the adopted bylaws and operating policies. I understand that failure to fulfill my duties may lead to review or action through the procedures in the bylaws. I intend my typed name to be my electronic signature. I am signing only for myself.";
const PAGE="<!doctype html><html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><base target=\"_top\"><style>body{margin:0;background:#000;color:#fff;font:17px Arial;line-height:1.6}main{max-width:900px;margin:auto;padding:25px}h1{font-size:32px}label{display:block;margin:18px 0}input,select{display:block;box-sizing:border-box;width:100%;padding:13px;font:inherit;border-radius:7px;border:1px solid #999;background:#fff;color:#111}input[type=checkbox]{display:inline;width:23px;height:23px;vertical-align:middle;margin-right:10px}button{background:#c8102e;color:#fff;border:0;border-radius:7px;padding:15px 20px;font:bold 17px Arial;cursor:pointer}button:disabled{opacity:.6}.note{background:#202020;padding:15px;border-left:4px solid #c8102e}#status{padding:15px;white-space:pre-wrap}a{color:#ffadb8}details{border:1px solid #666;padding:15px;margin:15px 0}.trap{display:none}</style></head><body><main><h1>Board Election Acceptance</h1><p>Complete this form yourself after you are elected or appointed. Your submitted acknowledgment is saved as a private PDF in the club\u2019s Google Drive and listed in your Board service record in the management portal.</p><p><a href=\"https://boneshakerssocialclub.com/requirements-to-serve\" target=\"_blank\">Read Board Service Requirements</a></p><details><summary>Read the requirements included in your signed record</summary><h2>Eligibility and term</h2><p>Your eligibility, election, appointment and term are governed by the adopted bylaws. Full voting membership in good standing, applicable renewal requirements and candidate qualifications must be verified from club records. Signing this acknowledgment does not grant a Board seat or an officer title. Confirm your actual term before signing.</p><h2>Commitment and attendance</h2><p>Serve your authorized term, prepare for and attend Board meetings, participate in general meetings, events and fundraisers, and complete assigned work between meetings. Notify the President AND Vice President at least 24 hours before an absence when practicable, or as soon as possible in a true emergency. Attendance exceptions, review and removal follow the adopted bylaws.</p><h2>Representation and respectful conduct</h2><p>Uphold the club\u2019s mission and reputation. Act respectfully toward members, officers, partners and the public. Follow meeting procedures and the chair\u2019s authorized directions. Ask questions and disagree constructively without threats, intimidation, personal attacks or disruption. Any corrective action follows the bylaws and fair process.</p><h2>Responsibilities and practical skills</h2><p>Review budgets, donations, policies and bylaws before voting. Use the club\u2019s email, phone and approved digital tools. Lead or support assigned committees, projects and events. Report progress, protect records and ask for help before deadlines are missed.</p><h2>Confidentiality and conflicts</h2><p>Protect private Board business, member information, finances and other nonpublic information during and after service. Confidentiality does not prevent required disclosures, good-faith reports to appropriate authorities or confidential professional advice. Disclose conflicts of interest and follow the applicable recusal rules.</p><h2>Financial and nonprofit stewardship</h2><p>Act in the club\u2019s best interests, follow spending and contract approval limits, keep receipts and protect designated funds. Support nonprofit and tax-exempt compliance. Do not make unauthorized commitments in the club\u2019s name. Complete any conflict-of-interest disclosure required by the Board.</p><h2>Fundraising and member support</h2><p>Support fundraising through volunteer time, promotion and practical work. Personal contributions are encouraged when able; no donation minimum is created here. Welcome and mentor members and support membership growth and retention.</p><h2>Officer selection and handover</h2><p>Election to the Board does not guarantee a particular office. Officer selection follows the bylaws. Be willing to support the assigned structure and learn your responsibilities. Transfer records, property, access and outstanding work through a documented handover when your role ends.</p><h2>Governing authority</h2><p>The adopted bylaws and operating policies control over this acknowledgment. This form does not amend qualifications, terms, authority, voting thresholds or removal procedures. Duties and conduct concerns are reviewed under the bylaws with required notice and a chance to respond. Based on the 2026 Requirements to Serve acknowledgment, updated for current governance wording.</p></details><form id=\"form\"><label>Full legal name<input name=\"name\" required maxlength=\"120\" autocomplete=\"name\"></label><label>Email address<input name=\"email\" type=\"email\" required maxlength=\"180\" autocomplete=\"email\"></label><label>Board service year<select name=\"year\"><option>2027</option><option>2028</option><option>2029</option><option>2030</option></select></label><label>Role or seat<input name=\"role\" required maxlength=\"100\" placeholder=\"Director, President, Secretary\u2026\"></label><label>Term begins<input name=\"start\" type=\"date\" required></label><label>Term ends<input name=\"end\" type=\"date\" required></label><label>Date elected or appointed<input name=\"election\" type=\"date\" required></label><label><input name=\"elected\" type=\"checkbox\" required>I confirm that I was elected or appointed to the Board and accept that service.</label><div class=\"note\">I accept my election or appointment to the BSSC Board for the service year shown. I have read, understand and agree to uphold the Board Service Requirements and the adopted bylaws and operating policies. I understand that failure to fulfill my duties may lead to review or action through the procedures in the bylaws. I intend my typed name to be my electronic signature. I am signing only for myself.</div><label><input name=\"agree\" type=\"checkbox\" required>I have read and agree to the statement above and the requirements included in this record.</label><label>Electronic signature<input name=\"signature\" required maxlength=\"120\" autocomplete=\"off\" placeholder=\"Type your full legal name\"></label><label class=\"trap\">Leave blank<input name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label><button id=\"submit\" type=\"submit\">Submit signed acceptance</button><p id=\"status\" role=\"status\" aria-live=\"polite\"></p></form><p class=\"note\">Your name and email are self-reported. The Secretary verifies this acknowledgment against the election and Board roster. Submission does not itself establish eligibility or authority. Contact the President or Secretary if you need a correction. Submitted records are retained; a correction creates a new record.</p></main><script>document.getElementById('form').onsubmit=function(e){e.preventDefault();var f=e.target,b=document.getElementById('submit'),s=document.getElementById('status'),d=Object.fromEntries(new FormData(f));d.agree=f.agree.checked;d.elected=f.elected.checked;b.disabled=true;b.style.background='#b17c00';b.textContent='Submitting\u2026';s.textContent='Saving your signed record\u2026';google.script.run.withSuccessHandler(function(r){if(!r.ok){b.disabled=false;b.style.background='#c8102e';b.textContent='Retry submission';s.textContent=r.error;return;}b.style.background='#176c39';b.textContent='Submitted';s.textContent='Your signed acceptance is saved. Reference: '+r.id+'\\nThe Secretary can open the PDF from your Board member record in the portal.';f.querySelectorAll('input,select').forEach(function(x){x.disabled=true;});}).withFailureHandler(function(){b.disabled=false;b.textContent='Check submission status';s.textContent='Could not confirm your submission. Contact the Secretary before submitting again.';}).submitAcceptance(d);};</script></body></html>";
const HEADERS=['Record ID','Submitted At','Service Year','Member Name','Email','Role','Term Start','Term End','Election Date','Signature','Document Version','PDF URL','Status','PDF SHA256'];
function doGet(){return HtmlService.createHtmlOutput(PAGE).setTitle('BSSC Board Election Acceptance').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function setupBoardService(){if(Session.getActiveUser().getEmail()!==Session.getEffectiveUser().getEmail()||!Session.getActiveUser().getEmail())throw Error("Owner setup only.");const book=SpreadsheetApp.openById(BOOK);let sheet=book.getSheetByName('Board Service Records');if(!sheet){sheet=book.insertSheet('Board Service Records');sheet.appendRow(HEADERS);sheet.setFrozenRows(1);}const parent=DriveApp.getFolderById(PARENT),it=parent.getFoldersByName('2027 and Later Online Acceptances');const folder=it.hasNext()?it.next():parent.createFolder('2027 and Later Online Acceptances');PropertiesService.getScriptProperties().setProperty('FOLDER',folder.getId());console.log('Board service record storage ready.');}
function clean_(v,n){return String(v||'').trim().slice(0,n||180);}
function cell_(v){v=String(v);return /^[=+@-]/.test(v)?"'"+v:v;}
function submitAcceptance(d){const lock=LockService.getScriptLock();try{lock.waitLock(30000);if(d.website)throw Error('Submission not accepted.');const name=clean_(d.name,120),email=clean_(d.email).toLowerCase(),signature=clean_(d.signature,120),year=Number(d.year);if(name.length<3||!/^\S+@\S+\.\S+$/.test(email)||signature.toLowerCase()!==name.toLowerCase()||d.agree!==true||d.elected!==true||![2027,2028,2029,2030].includes(year))throw Error('Complete all required fields. Your signature must match your full legal name.');for(const key of ['start','end','election'])if(!/^\d{4}-\d{2}-\d{2}$/.test(d[key]||''))throw Error('Enter valid term and election dates.');if(d.end<d.start||new Date(d.election+'T23:59:59Z')>new Date(Date.now()+86400000))throw Error('Check your term and election dates.');const role=clean_(d.role,100);if(!role)throw Error('Enter your Board role or seat.');const folderId=PropertiesService.getScriptProperties().getProperty('FOLDER');if(!folderId)throw Error('Record storage is not configured. Contact the Secretary.');const sheet=SpreadsheetApp.openById(BOOK).getSheetByName('Board Service Records');const existing=sheet.getDataRange().getDisplayValues().slice(1).find(r=>r[2]===String(year)&&r[4].toLowerCase()===email&&r[3].toLowerCase()===name.toLowerCase());if(existing)return {ok:true,id:existing[0]};const id='BSSC-BA-'+year+'-'+Utilities.getUuid().slice(0,8).toUpperCase(),at=new Date().toISOString();const doc=DocumentApp.create(id+' temporary'),body=doc.getBody();body.appendParagraph('BSSC Board Election Acceptance').setHeading(DocumentApp.ParagraphHeading.TITLE);for(const text of ['Reference: '+id,'Submitted: '+at,'Board service year: '+year,'Name: '+name,'Email (self-reported): '+email,'Role or seat: '+role,'Term: '+d.start+' through '+d.end,'Election or appointment date: '+d.election,'Requirements version: '+VERSION,'Status: Submitted — awaiting Secretary verification'])body.appendParagraph(text);SECTIONS.forEach(s=>{body.appendParagraph(s[0]).setHeading(DocumentApp.ParagraphHeading.HEADING2);body.appendParagraph(s[1]);});body.appendParagraph('Acknowledgment and acceptance').setHeading(DocumentApp.ParagraphHeading.HEADING1);body.appendParagraph(STATEMENT);body.appendParagraph('Electronically signed by: '+signature);body.appendParagraph('Signature and name were supplied by the respondent. Secretary verification against club records is required.');doc.saveAndClose();const temp=DriveApp.getFileById(doc.getId()),blob=temp.getAs(MimeType.PDF).setName('BSSC_Board_Acceptance_'+year+'_'+name.replace(/[^a-zA-Z0-9]+/g,'_')+'_'+id+'.pdf'),file=DriveApp.getFolderById(folderId).createFile(blob);const hash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,blob.getBytes()).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');try{sheet.appendRow([id,at,year,name,email,role,d.start,d.end,d.election,signature,VERSION,file.getUrl(),'Submitted - awaiting Secretary verification',hash].map(cell_));}catch(err){file.setTrashed(true);throw err;}temp.setTrashed(true);return {ok:true,id:id};}catch(err){return {ok:false,error:String(err.message||err)};}finally{if(lock.hasLock())lock.releaseLock();}}
